{
  "name": "vs-piclist",
  "displayName": "%ext.displayName%",
  "version": "1.3.2",
  "description": "%ext.description%",
  "categories": [
    "Other"
  ],
  "keywords": [
    "image",
    "picture",
    "upload",
    "picgo",
    "image upload",
    "picture upload",
    "piclist"
  ],
  "bugs": {
    "url": "https://github.com/Kuingsmile/vs-piclist/issues",
    "email": "pkukuing@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kuingsmile/vs-piclist.git"
  },
  "publisher": "Kuingsmile",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "yarn run typecheck && rolldown -c",
    "cz": "git-cz",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "yarn run typecheck && rolldown -c --minify --sourcemap hidden",
    "prepare": "husky",
    "release": "bump-version",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "vscode:prepublish": "yarn run package",
    "watch": "rolldown -c --watch"
  },
  "contributes": {
    "commands": [
      {
        "command": "piclist.uploadFromClipboard",
        "title": "%command.upload.clipboard.title%",
        "category": "PicList"
      },
      {
        "command": "piclist.uploadFromExplorer",
        "title": "%command.upload.explorer.title%",
        "category": "PicList"
      },
      {
        "command": "piclist.uploadFromInputBox",
        "title": "%command.upload.inputBox.title%",
        "category": "PicList"
      },
      {
        "command": "piclist.deleteImage",
        "title": "%command.delete.title%",
        "category": "PicList"
      },
      {
        "command": "piclist.openImageDB",
        "title": "%command.openImageDB.title%",
        "category": "PicList"
      },
      {
        "command": "piclist.uploadAllImgInFile",
        "title": "%command.uploadAllImgInFile.title%",
        "category": "PicList"
      },
      {
        "command": "piclist.uploadSelectedImg",
        "title": "%command.uploadSelectedImg.title%",
        "category": "PicList"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%config.title%",
      "properties": {
        "piclist.uploadAPIUrl": {
          "type": "string",
          "default": "http://127.0.0.1:36677/upload",
          "markdownDescription": "%config.uploadAPIUrl.description%"
        },
        "piclist.deleteAPIUrl": {
          "type": "string",
          "default": "http://127.0.0.1:36677/delete",
          "markdownDescription": "%config.deleteAPIUrl.description%"
        },
        "piclist.copyType": {
          "type": "string",
          "default": "markdown",
          "markdownDescription": "%config.copyType.description%",
          "enum": [
            "markdown",
            "html",
            "url",
            "ubb",
            "custom"
          ],
          "enumDescriptions": [
            "%config.copyType.markdown%",
            "%config.copyType.html%",
            "%config.copyType.url%",
            "%config.copyType.ubb%",
            "%config.copyType.custom%"
          ]
        },
        "piclist.customType": {
          "type": "string",
          "default": "![$fileName]($url)",
          "markdownDescription": "%config.customType.description%"
        },
        "piclist.encodeUrl": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.encodeUrl.description%"
        },
        "piclist.remoteServerMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.remoteServerMode.description%"
        },
        "piclist.enableDragUpload": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.enableDragUpload.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "piclist.uploadFromClipboard",
        "key": "ctrl+alt+U",
        "mac": "cmd+alt+U"
      },
      {
        "command": "piclist.uploadFromExplorer",
        "key": "ctrl+alt+E",
        "mac": "cmd+alt+E"
      },
      {
        "command": "piclist.uploadFromInputBox",
        "key": "ctrl+alt+O",
        "mac": "cmd+alt+O"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "piclist.deleteImage",
          "when": "editorTextFocus"
        },
        {
          "command": "piclist.uploadSelectedImg",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:plaintext",
    "onLanguage:markdown"
  ],
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "form-data": "^4.0.6",
    "fs-extra": "^11.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "node-bump-version": "^3.0.0",
    "prettier": "^3.9.10",
    "rolldown": "1.2.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "vscode": "^1.100.0"
  },
  "icon": "logo.png",
  "bumpVersion": {
    "preset": "emoji"
  },
  "extensionKind": [
    "ui"
  ]
}
